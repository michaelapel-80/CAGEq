; COM in-proc server exports. PRIVATE keeps them out of the import library — nothing
; links against this DLL; COM and regsvr32 find these by name via GetProcAddress.
LIBRARY CAGEqApo
EXPORTS
    DllCanUnloadNow       PRIVATE
    DllGetClassObject     PRIVATE
    DllRegisterServer     PRIVATE
    DllUnregisterServer   PRIVATE
