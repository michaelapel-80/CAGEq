{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAGEq",
  "version": "0.7.0",
  "identifier": "com.cageq.desktop",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-apo-staleness.ps1 & npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-apo-staleness.ps1 -Block && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CAGEq",
        "width": 1320,
        "height": 960,
        "minWidth": 700,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "sidecar/cageq-sidecar": "sidecar",
      "apo": "apo"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
